<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MilLeadershipBoard.UI.UserControls.MaximizeableImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.UI.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnSizeChanged">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                x:Name="HeaderTextBlock"
                Text="{x:Bind Header, Mode=OneWay}"
                Style="{x:Bind HeaderStyle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HeaderVisibility, Mode=OneWay}"
                Margin="0,0,0,12"/>

            <Image
                Grid.Row="1"
                x:Name="BaseImageControl"
                Stretch="{x:Bind Stretch, Mode=OneWay}"
                Source="{x:Bind Source, Mode=OneWay}">

                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="MaximizeableImageView/Image/Tooltip"/>
                </ToolTipService.ToolTip>
            </Image>
        </Grid>
        
        <Popup
            x:Name="MaximizedViewPopup"
            IsLightDismissEnabled="True"
            IsOpen="{x:Bind ViewModel.IsMaximizedViewOpen, Mode=TwoWay}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalOffset="{x:Bind ViewModel.HorizontalPopupOffset, Mode=OneWay}"
            VerticalOffset="{x:Bind ViewModel.VerticalPopupOffset, Mode=OneWay}">
            
            <Grid
                x:Name="PopupGrid"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Height="{x:Bind ViewModel.PopupHeight, Mode=OneWay}"
                Width="{x:Bind ViewModel.PopupWidth, Mode=OneWay}">

                <Border
                    x:Name="PopupBorder"
                    Background="{StaticResource TileBackgroundFillColor}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tapped="PopupBorder_Tapped"/>

                <Border
                    Background="{ThemeResource PopupBackgroundBrush}"
                    BorderBrush="{ThemeResource PopupBorderBrush}"
                    BorderThickness="{StaticResource ContentDialogBorderWidth}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="32"
                    PointerEntered="Border_PointerEntered"
                    PointerExited="Border_PointerExited">

                    <Grid>
                        <Border
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Margin="8">

                            <Image
                                x:Name="PopupImageControl"
                                Stretch="Uniform"
                                Source="{x:Bind Source, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                KeyDown="PopupImageControl_KeyDown"/>
                        </Border>

                        <Border
                            x:Name="CloseButtonBorder"
                            Background="{ThemeResource PopupBackgroundBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind ViewModel.CloseButtonVisibility, Mode=OneWay}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="12">
                            <Button
                                Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}">
                                <SymbolIcon Symbol="Cancel"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
