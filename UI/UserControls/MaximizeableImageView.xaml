<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MilLeadershipBoard.UI.UserControls.MaximizeableImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.UI.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Image
            x:Name="BaseImageControl"
            Stretch="{x:Bind Stretch, Mode=OneWay}"
            Source="{x:Bind Source, Mode=OneWay}"
            Tapped="BaseImageControl_Tapped">

            <ToolTipService.ToolTip>
                <ToolTip x:Uid="MaximizeableImageView/Image/Tooltip"/>
            </ToolTipService.ToolTip>
        </Image>

        <Popup
            x:Name="MaximizedViewPopup"
            IsLightDismissEnabled="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid
                x:Name="PopupGrid"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

                <Border
                    x:Name="PopupBorder"
                    Background="{StaticResource TileBackgroundFillColor}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tapped="PopupBorder_Tapped"/>

                <Border
                    Background="{ThemeResource PopupBackgroundBrush}"
                    BorderBrush="{ThemeResource PopupBorderBrush}"
                    BorderThickness="{StaticResource ContentDialogBorderWidth}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="32"
                    PointerEntered="Border_PointerEntered"
                    PointerExited="Border_PointerExited">

                    <Grid>
                        <Border
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Margin="8">

                            <Image
                                x:Name="PopupImageControl"
                                Stretch="Uniform"
                                Source="{x:Bind Source, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                KeyDown="PopupImageControl_KeyDown"/>
                        </Border>

                        <Border
                            x:Name="CloseButtonBorder"
                            Background="{ThemeResource PopupBackgroundBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind CloseButtonVisibility, Mode=OneTime}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="12">
                            <Button>
                                <SymbolIcon Symbol="Cancel"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
