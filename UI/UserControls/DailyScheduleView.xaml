<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MilLeadershipBoard.UI.UserControls.DailyScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:MilLeadershipBoard.UI.UserControls"
    mc:Ignorable="d">

    <Grid
        x:Name="BaseGrid">

        <uc:MaximizeableImageView
            Header="{x:Bind ViewModel.HeaderText, Mode=OneWay}"
            HeaderStyle="{StaticResource BodyLargeTextBlockStyle}"
            Source="{x:Bind Model.Source, Mode=OneWay}"
            Stretch="Uniform"
            OverlayContentVisibility="{x:Bind ViewModel.OptionsButtonVisibility, Mode=OneWay}">

            <uc:MaximizeableImageView.OverlayContent>
                <Button
                    x:Name="OptionsButton"
                    Background="{ThemeResource OverlayButtonBackgroundColor}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12">

                    <Button.Shadow>
                        <ThemeShadow/>
                    </Button.Shadow>

                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Name="EditFlyoutItem"
                                x:Uid="DailyScheduleView/OptionsFlyout/EditButton"
                                Command="{x:Bind ViewModel.EditDateCommand, Mode=OneTime}">

                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Edit"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Name="DeleteFlyoutItem"
                                x:Uid="DailyScheduleView/OptionsFlyout/DeleteButton"
                                Command="{x:Bind ViewModel.DeleteCommand, Mode=OneTime}">

                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Delete"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>

                    <FontIcon Glyph="&#xE70D;" />
                </Button>
            </uc:MaximizeableImageView.OverlayContent>
        </uc:MaximizeableImageView>
    </Grid>
</UserControl>
