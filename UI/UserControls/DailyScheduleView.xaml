<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MilLeadershipBoard.UI.UserControls.DailyScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.UI.UserControls"
    xmlns:uc="using:MilLeadershipBoard.UI.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="BaseGrid">

        <uc:MaximizeableImageView
            Header="{x:Bind ViewModel.HeaderText, Mode=OneWay}"
            HeaderStyle="{StaticResource BodyLargeTextBlockStyle}"
            Source="{x:Bind Model.Source, Mode=OneWay}"
            Stretch="Uniform"/>

        <Border
            x:Name="OptionsButtonBorder"
            Background="{ThemeResource OverlayButtonBackgroundColor}"
            Visibility="{x:Bind ViewModel.OptionsButtonVisibility, Mode=OneWay}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12,48">

            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>

            <Button
                x:Name="OptionsButton">

                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Name="EditFlyoutItem"
                            x:Uid="DailyScheduleView/OptionsFlyout/EditButton"
                            Command="{x:Bind ViewModel.EditDateCommand, Mode=OneTime}">

                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Edit"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            x:Name="DeleteFlyoutItem"
                            x:Uid="DailyScheduleView/OptionsFlyout/DeleteButton"
                            Command="{x:Bind ViewModel.DeleteCommand, Mode=OneTime}">

                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Delete"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>

                <FontIcon Glyph="&#xE70D;" />
            </Button>
        </Border>
    </Grid>
</UserControl>
