<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MilLeadershipBoard.UI.UserControls.LessionDataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.UI.UserControls"
    xmlns:vm="using:MilLeadershipBoard.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinHeight="40"
    Unloaded="UserControl_Unloaded">

    <Grid
        x:Name="MainGrid"
        Loaded="MainGrid_Loaded">
        <Grid.DataContext>
            <vm:LessionDataViewModel/>
        </Grid.DataContext>

        <Border
            Background="{StaticResource SystemFillColorSuccessBackgroundBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{Binding CompletionContentVisibility, Mode=OneWay}"
            CornerRadius="8">

            <SymbolIcon
                Symbol="Accept"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
        </Border>

        <Grid
            ColumnSpacing="8"
            Visibility="{Binding MainContentVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="{Binding LessionName}"/>

                <TextBlock
                    Grid.Row="1"
                    Foreground="{StaticResource DimForegroundColor}"
                    Text="{Binding LessionChiefName}"/>
            </Grid>

            <Button
                Grid.Column="1"
                Style="{StaticResource FlatButtonStyle}">

                <Button.Flyout>
                    <MenuFlyout>

                        <MenuFlyoutItem
                            x:Name="CompleteFlyoutItem"
                            x:Uid="LessionDataView/CompleteFlyoutButton"
                            Command="{Binding CompleteLessionCommand}">

                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Accept"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>

                <FontIcon Glyph="&#xE70D;"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
