<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MilLeadershipBoard.UI.UserControls.ExceptionMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.UI.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
        Spacing="8">

        <TextBlock
            x:Name="ExpandExceptionTextBlock"
            Text="{x:Bind ViewModel.ExceptionTextBlockText, Mode=OneWay}"
            IsTextSelectionEnabled="True"
            Visibility="{x:Bind ViewModel.ExceptionTextBlockVisibility, Mode=OneWay}"/>

        <HyperlinkButton
            x:Name="ExpandExceptionDetailsHyperlinkButton"
            Content="{x:Bind ViewModel.ExpandExceptionDetailsHyperlinkButtonText, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
