<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MilLeadershipBoard.UI.Pages.BreaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.UI.Pages"
    xmlns:vm="using:MilLeadershipBoard.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:BreaksPageViewModel/>
    </Page.DataContext>

    <Grid
        Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock
            x:Uid="BreaksPage_Title"
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"/>

        <Grid
            Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                Text="{Binding BreaksText, Mode=OneWay}"
                VerticalAlignment="Center"/>

            <Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Command="{Binding ResetBreaksCommand}">

                <SymbolIcon Symbol="Clear"/>
            </Button>
        </Grid>

        <TextBlock
            x:Uid="BreaksPage/AddBreakHeaderTextBlock"
            Grid.Row="2"
            Margin="0,0,0,8"/>

        <Grid
            Grid.Row="3"
            ColumnSpacing="8"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button
                x:Uid="BreaksPage/AddFiveMinButton"
                Grid.Column="0"
                Command="{Binding Add5MinCommand}"
                HorizontalAlignment="Stretch"/>

            <Button
                x:Uid="BreaksPage/AddTenMinButton"
                Grid.Column="1"
                Command="{Binding Add10MinCommand}"
                HorizontalAlignment="Stretch"/>

            <Button
                x:Uid="BreaksPage/AddFifteenMinButton"
                Grid.Column="2"
                Command="{Binding Add15MinCommand}"
                HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Page>
