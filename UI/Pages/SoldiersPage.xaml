<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MilLeadershipBoard.UI.Pages.SoldiersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.UI.Pages"
    xmlns:config="using:MilLeadershipBoard.Config"
    xmlns:tv="using:WinUI.TableView"
    xmlns:vm="using:MilLeadershipBoard.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.DataContext>
        <vm:SoldiersPageViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="16,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="100" Width="*"/>
                <ColumnDefinition MaxWidth="300" Width="2*"/>
                <ColumnDefinition MaxWidth="300" Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Uid="SoldiersPage/RankTextBox"
                x:Name="RankTextBox"
                Grid.Column="0"
                Text="{Binding NewSoldierRank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBox
                x:Uid="SoldiersPage/LastNameTextBox"
                Grid.Column="1"
                Text="{Binding NewSoldierLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBox
                x:Uid="SoldiersPage/FirstNameTextBox"
                Grid.Column="2"
                Text="{Binding NewSoldierFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Button
                x:Uid="SoldiersPage/AddButton"
                Grid.Column="4"
                Command="{Binding CreateCommand}"/>
        </Grid>

        <tv:TableView
            Grid.Row="1"
            ItemsSource="{Binding Soldiers}"
            AutoGenerateColumns="False"
            HorizontalAlignment="Stretch"
            Margin="16,8,16,16">

            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    x:Uid="SoldiersPage/SoldiersTable/RankColumn"
                    Binding="{Binding Rank}"
                    Width="100"/>
                
                <tv:TableViewTextColumn
                    x:Uid="SoldiersPage/SoldiersTable/LastNameColumn"
                    Binding="{Binding LastName}"
                    Width="300"/>
                
                <tv:TableViewTextColumn
                    x:Uid="SoldiersPage/SoldiersTable/FirstNameColumn"
                    Binding="{Binding FirstName}"
                    Width="300"/>

                <tv:TableViewTemplateColumn
                    x:Uid="SoldiersPage/SoldiersTable/LocationColumn"
                    Width="300">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding LocationName}"
                                Margin="8"/>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                x:Uid="SoldiersPage/SoldiersTable/LocationCellComboBox"
                                ItemTemplate="{StaticResource SoldierLocationItemDataTemplate}"
                                ItemsSource="{Binding Locations, Mode=OneWay}"
                                SelectedItem="{Binding Location, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"/>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
            </tv:TableView.Columns>
        </tv:TableView>
    </Grid>
</Page>
