<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MilLeadershipBoard.UI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.UI.Pages"
    xmlns:pages="using:MilLeadershipBoard.UI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="MainGrid"
        ColumnSpacing="{StaticResource DashboardTileMargin}"
        Padding="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- Locations -->
        <Border
            Grid.Column="0"
            Style="{StaticResource DefaultDashboardTileStyle}">

            <pages:LocationsPage/>
        </Border>

        <!-- Weekly Schedule, Special Commands, Lessions & Breaks -->

        <Grid
            Grid.Column="1"
            RowSpacing="{StaticResource DashboardTileMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Style="{StaticResource DefaultDashboardTileStyle}">

                <pages:WeeklySchedulePage/>
            </Border>

            <Grid
                Grid.Row="1"
                ColumnSpacing="{StaticResource DashboardTileMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Style="{StaticResource DefaultDashboardTileStyle}">

                    <pages:SpecialAssignmentsPage/>
                </Border>

                <Grid
                    Grid.Column="1"
                    RowSpacing="{StaticResource DashboardTileMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Style="{StaticResource DefaultDashboardTileStyle}">

                        <pages:LessionsPage/>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Style="{StaticResource DefaultDashboardTileStyle}">

                        <pages:BreaksPage/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Daily Schedule -->
        <Border
            Grid.Column="3"
            Style="{StaticResource DefaultDashboardTileStyle}">

            <pages:DailySchedulePage/>
        </Border>
    </Grid>
</Page>
