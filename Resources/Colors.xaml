<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.Resources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush
                x:Key="TileBackgroundFillColor"
                Color="#0DFFFFFF"/>
            <SolidColorBrush
                x:Key="DimForegroundColor"
                Color="#A0FFFFFF"/>
            <SolidColorBrush
                x:Key="PopupBackgroundBrush"
                Color="#1F1F1F"/>
            <SolidColorBrush
                x:Key="PopupBorderBrush"
                Color="#3F3F3F"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush
                x:Key="TileBackgroundFillColor"
                Color="#0E000000"/>
            <SolidColorBrush
                x:Key="DimForegroundColor"
                Color="#a0000000"/>
            <SolidColorBrush
                x:Key="PopupBackgroundBrush"
                Color="#EFEFEF"/>
            <SolidColorBrush
                x:Key="PopupBorderBrush"
                Color="LightGray"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
