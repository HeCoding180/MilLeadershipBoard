<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard.Resources">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush
                x:Key="TileBackgroundFillColor"
                Color="#0DFFFFFF"/>
            <SolidColorBrush
                x:Key="DimForegroundColor"
                Color="#A0FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush
                x:Key="TileBackgroundFillColor"
                Color="#0D000000"/>
            <SolidColorBrush
                x:Key="DimForegroundColor"
                Color="#a0000000"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
