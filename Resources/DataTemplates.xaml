<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="MilLeadershipBoard.Resources.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MilLeadershipBoard"
    xmlns:locationData="using:MilLeadershipBoard.TroopData.Location"
    xmlns:soldierData="using:MilLeadershipBoard.TroopData"
    xmlns:uc="using:MilLeadershipBoard.UI.UserControls">

    <DataTemplate
        x:Key="SimpleSoldierDataTemplate"
        x:DataType="soldierData:SoldierData">
        
        <StackPanel
            Orientation="Horizontal"
            Spacing="5">
            
            <TextBlock Text="{Binding Rank}"/>
            <TextBlock Text="{Binding LastName}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate
        x:Key="SoldierLocationDataTemplate"
        x:DataType="locationData:SoldierLocation">
        
        <uc:SoldierLocationView Location="{Binding}"/>
    </DataTemplate>
</ResourceDictionary>
